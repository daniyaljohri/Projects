# Copy this file to .env and fill in the values. Never commit .env.

ANTHROPIC_API_KEY=
ASKIT_MODEL=claude-haiku-5-5

# Data pack to load from packs/
ASKIT_PACK=olist

# Database: tsql (SQL Server) or sqlite
ASKIT_DB_DIALECT=tsql

# SQL Server: an ODBC connection string for the read-only login
ASKIT_DB_CONNECTION=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=Olist_DWP;UID=askit_reader;PWD=;TrustServerCertificate=yes

# SQLite: a path to the database file instead
# ASKIT_DB_DIALECT=sqlite
# ASKIT_DB_CONNECTION=data/olist.sqlite

# How many times a query that failed to parse or run is sent back to Claude to fix (0 to 3)
ASKIT_SQL_RETRIES=1

# Schema retrieval: off sends every table; keyword, embedding or hybrid send only the most relevant ones
ASKIT_SCHEMA_RETRIEVAL=off
ASKIT_SCHEMA_TOP_K=3
# Local embedding model for embedding and hybrid retrieval, downloaded once into index/models
ASKIT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
