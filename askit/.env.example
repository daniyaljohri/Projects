# Copy this file to .env and fill in the values. Never commit .env.

ANTHROPIC_API_KEY=
ASKIT_MODEL=claude-haiku-5-5

# Data pack to load from packs/
ASKIT_PACK=olist

# Database: tsql (SQL Server) or sqlite
ASKIT_DB_DIALECT=tsql

# SQL Server: an ODBC connection string for the read-only login
ASKIT_DB_CONNECTION=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=Olist_DWP;UID=askit_reader;PWD=;TrustServerCertificate=yes

# SQLite: a path to the database file instead
# ASKIT_DB_DIALECT=sqlite
# ASKIT_DB_CONNECTION=data/olist.sqlite
